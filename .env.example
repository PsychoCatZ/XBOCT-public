# XBOCT configuration. Only variables the code reads today are listed.
# Never commit real values; set secrets on the server only.

# test | demo | production (production requires the settings in deploy/xboct.env.example)
APP_ENV=demo
# Local SQLite file; the directory is created by `xboct migrate`.
DATABASE_URL=sqlite+aiosqlite:///./data/xboct.db
# IANA timezone used for new settings (starting default, editable later).
USER_TIMEZONE=Asia/Krasnoyarsk
# fixture (no model; free text gets an honest "не разобрал") or openai.
LLM_PROVIDER=fixture
# Only for LLM_PROVIDER=openai. Set the key on the server only, never commit it.
OPENAI_API_KEY=
# Exact model id, chosen after access/quality/budget checks (no default on purpose).
OPENAI_MODEL=
# Explicit reasoning effort sent to the Responses API (none|minimal|low|medium|high|xhigh);
# empty = not sent.
OPENAI_REASONING_EFFORT=
# Maximum provider calls per local day (including the single retry).
LLM_DAILY_CALL_LIMIT=50

# Needed by `xboct run` and `xboct serve` (without --no-bot). Leave empty here.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id of the owner; only this private chat is served.
TELEGRAM_OWNER_ID=

# Web interface (`xboct serve`). Login codes come from /login in the bot's private chat.
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Session lifetime in days (1..30).
WEB_SESSION_DAYS=7
# Secure cookies; false is accepted only with a localhost WEB_HOST (local demo).
WEB_SECURE_COOKIES=true
# Origin the browser sees behind the HTTPS reverse proxy, e.g. https://xboct.example.
WEB_PUBLIC_ORIGIN=
# Behind a reverse proxy: whose X-Forwarded-For to trust (the compose app sets "*").
WEB_TRUSTED_PROXIES=127.0.0.1

# Daily consistent snapshots (required in production). Absolute path; 7 daily + 4 weekly.
BACKUP_DIR=
# Local time (USER_TIMEZONE) after which the daily snapshot is taken.
BACKUP_TIME=04:00
