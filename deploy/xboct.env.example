# Copy to /etc/xboct/xboct.env on the server: root-owned, chmod 600. Never commit real values.
APP_ENV=production
USER_TIMEZONE=Asia/Krasnoyarsk
# HTTPS origin the browser uses (domain chosen with Codex before going live).
WEB_PUBLIC_ORIGIN=https://xboct.example
WEB_SECURE_COOKIES=true
WEB_SESSION_DAYS=7
# Telegram: bot token from @BotFather and the owner's numeric user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Model: fixture = degraded (forms, buttons, reminders work; free text is not parsed).
LLM_PROVIDER=fixture
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
LLM_DAILY_CALL_LIMIT=50
# Daily snapshot time (local, USER_TIMEZONE). BACKUP_DIR is /backups in the image.
BACKUP_TIME=04:00
